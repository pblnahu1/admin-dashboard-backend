{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "bunx eslint .",
    "preview": "vite preview",
    "typecheck": "bunx tsc --noEmit -p tsconfig.app.json",
    "test": "bunx jest",
    "test:watch": "bunx jest --watch",
    "test:coverage": "bunx jest --coverage",
    "docker:build": "docker build -t vite-react-typescript-starter .",
    "docker:run": "docker run --rm -p 80:80 vite-react-typescript-starter"
  },
  "dependencies": {
